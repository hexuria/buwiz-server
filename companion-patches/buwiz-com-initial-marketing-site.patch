--- /dev/null
+++ b/scripts/deploy.sh
@@ -0,0 +1,30 @@
+#!/usr/bin/env bash
+# Print the buwiz.com deploy plan. Does not change DNS and does not deploy
+# unless BUWIZ_DEPLOY_CONFIRM=deploy-buwiz-com.
+set -euo pipefail
+
+root="$(cd "$(dirname "$0")/.." && pwd)"
+cd "$root"
+
+echo "buwiz.com deploy plan (dry run unless BUWIZ_DEPLOY_CONFIRM is set)"
+echo
+echo "DNS — set these by hand. This script does not."
+echo "  www.buwiz.com  CNAME  <site-app>.fermyon.app"
+echo "  buwiz.com      ALIAS  <site-app>.fermyon.app"
+echo
+echo "account.buwiz.com and api.buwiz.com are buwiz-server, not this app."
+echo "No secrets. No database."
+
+if [[ "${BUWIZ_DEPLOY_CONFIRM:-}" != "deploy-buwiz-com" ]]; then
+  echo
+  echo "Dry run only. Export BUWIZ_DEPLOY_CONFIRM=deploy-buwiz-com to run:"
+  echo "  spin cloud deploy"
+  exit 0
+fi
+
+if ! command -v spin >/dev/null 2>&1; then
+  echo "spin is not on PATH" >&2
+  exit 1
+fi
+
+exec spin cloud deploy "$@"
